# Standalone Compose settings. Copy to cmd/booking/.env and use --env-file.
# For a direct Go launch, export BOOKING_DATABASE_URL as DATABASE_URL.

# HTTP listener
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=5s

# PostgreSQL — required
BOOKING_POSTGRES_USER=booking
BOOKING_POSTGRES_PASSWORD=change-me
BOOKING_POSTGRES_DB=booking
BOOKING_DATABASE_URL=postgres://booking:change-me@postgres:5432/booking?sslmode=disable
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me

# RabbitMQ event bus — opt-in
EVENTS_ENABLED=true
RABBITMQ_URL=amqp://change-me:change-me@rabbitmq:5672/
RABBITMQ_EXCHANGE=booking.events

# JWT — required. Must match auth-service's signing secret in production.
# Replace this placeholder before running.
JWT_SECRET=change-me
BOOKING_VERSION=v1
