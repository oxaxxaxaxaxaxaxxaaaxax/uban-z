# Database credentials and connection URLs must match. URL-encode URL passwords.
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=change-me
AUTH_POSTGRES_DB=auth
AUTH_DATABASE_URL=postgres://auth:change-me@auth-postgres:5432/auth?sslmode=disable
BOOKING_POSTGRES_USER=booking
BOOKING_POSTGRES_PASSWORD=change-me
BOOKING_POSTGRES_DB=booking
BOOKING_DATABASE_URL=postgres://booking:change-me@booking-postgres:5432/booking?sslmode=disable
JWT_SECRET=change-me
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://change-me:change-me@rabbitmq:5672/
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=5s
EVENTS_ENABLED=true
PARSER_BASE_URL=https://table.nsu.ru
PARSER_TIMEOUT=30s
PARSER_WEEKS_AHEAD=16
PARSER_DEFAULT_BUILDING=НГУ
PARSER_DEFAULT_CAPACITY=30
PARSER_TIMEZONE=Asia/Novosibirsk
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080
AUTH_VERSION=v1
BOOKING_VERSION=v1
GATEWAY_VERSION=v1
